# Postgres. Neon pooled URL in prod, or local docker:
# DATABASE_URL=postgresql://pingpong:pingpong@localhost:5432/pingpong
DATABASE_URL=

# Long random string used to sign session cookies
JWT_SECRET=

# Public URL of the app (used for links in notification emails)
APP_URL=http://localhost:5173

# Optional: Gmail SMTP for match notification emails (2-Step Verification + App Password).
# If SMTP_USER is empty, notifications are printed to the server console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional comma-separated allow-list on top of the @slalom.com rule (pilot mode).
ALLOWED_EMAILS=

# Comma-separated admin emails (can reset other users' passwords).
ADMIN_EMAILS=
